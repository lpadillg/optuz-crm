# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor (webhook y agente). Nunca exponer al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API de Meta (guía: README → "Conectar WhatsApp (API de Meta)"; utilidades: `npm run whatsapp -- <comando>`)
# developers.facebook.com → tu app → Configuración → Básica
META_APP_ID=
META_APP_SECRET=
# Meta Business Suite → Configuración → Cuentas → Cuentas de WhatsApp (id del WABA)
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Lo muestra `npm run whatsapp -- numbers` (es un id largo, NO el número de teléfono)
WHATSAPP_PHONE_NUMBER_ID=
# Token PERMANENTE de un usuario del sistema con permisos whatsapp_business_messaging y whatsapp_business_management
WHATSAPP_ACCESS_TOKEN=
# Lo genera `npm run whatsapp -- token`; es el mismo que se registra en el webhook de la app
WHATSAPP_VERIFY_TOKEN=
# Opcionales
META_GRAPH_VERSION=v25.0

# Google Calendar: cuenta de servicio con los calendarios compartidos con su email.
# NO lo rellenes a mano: descarga la clave JSON y corre  npm run google -- key "ruta\clave.json"  (README → Conectar Google Calendar)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Clave privada PEM; en Vercel pegar con \n literales
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CALENDAR_TIMEZONE=America/Lima

# Agente IA
# platform.openai.com → API keys (la API se paga con crédito prepago aparte de ChatGPT)
OPENAI_API_KEY=
# Opcionales. Por defecto gpt-5.6-terra. Otros: gpt-5.6-luna (más barato), gpt-5.6-sol (mejor), gpt-4o-mini (barato, no razona)
OPENAI_MODEL=gpt-5.6-terra
# none | minimal | low | medium | high. Solo aplica a modelos de razonamiento (gpt-5.x, gpt-6, serie o); gpt-4o los ignora
OPENAI_REASONING_EFFORT=medium
# Marca que usa el agente en sus mensajes
BUSINESS_NAME=
BRAND_TONE=cercano y amable, con pocos emojis y mensajes cortos

# Protege /api/calendar/* cuando las llama el agente o cron (Bearer)
INTERNAL_API_SECRET=

# ── Tareas en segundo plano (README → «Tareas en segundo plano») ──
# Secreto con el que un cron externo llama a /api/jobs/run (cabecera x-cron-secret o Bearer). Sin él, el endpoint responde 503.
CRON_SECRET=
# Milisegundos que el agente espera para juntar mensajes seguidos del cliente antes de responder (por defecto 4000)
AGENT_DEBOUNCE_MS=4000
# Minutos sin respuesta del cliente antes de UN seguimiento (solo dentro de las 24 h de WhatsApp). 0 = desactivado
FOLLOWUP_AFTER_MINUTES=180
# Avisos por correo cuando un chat lleva 15 min sin atender (opcional; sin esto solo se avisa en el panel). resend.com
RESEND_API_KEY=
ALERT_EMAIL_FROM=
# Nota de voz → texto (por defecto gpt-4o-mini-transcribe)
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Plantilla de WhatsApp para recordar citas fuera de las 24 h (se crea en el panel → Plantillas)
REMINDER_TEMPLATE=cita_recordatorio
# Horas sin que el cliente conteste antes de moverlo a «Sin respuesta» en el tablero (24 h = la ventana de WhatsApp)
NO_REPLY_HOURS=24
# Días en «Sin respuesta» tras los que el contacto se archiva solo. 0 lo desactiva
ARCHIVE_AFTER_DAYS=30

# ── Ritmo al responder ──
# El «escribiendo…» de WhatsApp se apaga cuando sale el mensaje, así que el ritmo se ajusta retrasando el envío.
# Caracteres por segundo que el bot «teclea» (22 ≈ una persona rápida en el celular). 0 = responder en cuanto esté listo
TYPING_CHARS_PER_SECOND=22
# Lo que tarda en «leer» antes de empezar a escribir
TYPING_LEAD_MS=700
# Nunca responder más rápido que esto (una respuesta instantánea delata al bot)
TYPING_MIN_MS=1200
# Ni hacer esperar más que esto, por larga que sea la respuesta
TYPING_MAX_MS=7000

# Cuántas citas próximas puede tener a la vez un mismo cliente (y su familia). Por defecto 3
MAX_ACTIVE_APPOINTMENTS=3
# Cuántas citas puede crear un cliente en un día; al llegar al tope el chat pasa a una persona. 0 = sin tope. Por defecto 3
MAX_APPOINTMENTS_PER_DAY=3
# API de Conversiones de Meta: id del conjunto de datos (Administrador de eventos). Vacío = no se envía nada a Meta
META_DATASET_ID=
CAPI_EVENT_SCHEDULE=Schedule
